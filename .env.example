# Copy to .env — docker compose reads it automatically.
# Image to run (set to your GHCR image after the first CI publish).
SEALDROP_IMAGE=ghcr.io/unabomber/secureshare:latest
HOST_PORT=8480

# Header carrying the real client IP (set by nginx). Empty = use socket address.
CLIENT_IP_HEADER=x-real-ip

# Proof-of-work difficulty in leading zero bits (each +1 doubles client cost).
POW_BITS=17
MAX_SECRET_BYTES=8192
MAX_DROPS=20000
